# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Required for the Telegram bot. Create one with @BotFather and paste the token.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot).
# Leave empty to allow anyone who finds the bot (not recommended).
TELEGRAM_ALLOWED_USER_IDS=

# Your niche. Used when analysing posts and generating ideas.
CAPTURER_NICHE=college applications and studying abroad

# Optional overrides
# CAPTURER_MODEL=claude-opus-5
# CAPTURER_DATA_DIR=./data          # SQLite db + downloaded media live here
# CAPTURER_WHISPER_MODEL=small      # tiny | base | small | medium | large-v3
# CAPTURER_FRAMES=6                 # keyframes sent to Claude per video
# CAPTURER_KEEP_MEDIA=false         # keep downloaded videos after processing

# Instagram often requires a logged-in session to download. Pick ONE:
# INSTAGRAM_COOKIES_FROM_BROWSER=chrome   # chrome | firefox | safari | edge | brave
# INSTAGRAM_COOKIES_FILE=./cookies.txt    # Netscape-format cookies export
