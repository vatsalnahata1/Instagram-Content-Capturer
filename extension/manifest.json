{
  "manifest_version": 3,
  "name": "Instagram Content Capturer",
  "version": "0.2.0",
  "description": "Files every reel you actually watch into your local content idea bank.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["extract.js", "intercept.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Content Capturer" }
}
